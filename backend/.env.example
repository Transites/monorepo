# Database - Supabase
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_SSL=true
SUPABASE_URL=https://[project-id].supabase.co
SUPABASE_ANON_KEY=[public-anon-key]

# Email - SMTP Gmail (ativo)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
GMAIL_SMTP_USER_PRIMARY=enciclopedia.iea.usp@gmail.com
GMAIL_SMTP_PASS_PRIMARY=[senha_do_gmail_primario]
GMAIL_SMTP_USER_SECONDARY=enciclopediaprojeto@gmail.com
GMAIL_SMTP_PASS_SECONDARY=[senha_do_gmail_secundario]
FROM_EMAIL=enciclopedia.iea.usp@gmail.com
FROM_NAME=Enciclopédia Transitos
REPLY_TO=enciclopedia.iea.usp@gmail.com

# Email - Resend (mantido para uso futuro)
RESEND_API_KEY=re_[sua_chave_api]

# Storage - Cloudinary
CLOUDINARY_URL=cloudinary://[api_key]:[api_secret]@[cloud_name]
CLOUDINARY_CLOUD_NAME=[cloud_name]
UPLOAD_MAX_SIZE=10MB
ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Zenodo
ZENODO_ENABLED=true
ZENODO_ACCESS_TOKEN=
ZENODO_BASE_URL=https://zenodo.org
ZENODO_LICENSE=cc-by-4.0

# Core
NODE_ENV=development
PORT=3000

# Strapi Configuration (existing)
HOST=0.0.0.0
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
